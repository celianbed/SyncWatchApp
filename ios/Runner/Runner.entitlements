<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Notifications push. Xcode remplace « development » par « production »
	     lors de l'archivage pour l'App Store : ne pas le figer à production ici,
	     sinon les builds de debug ne se signent plus. -->
	<key>aps-environment</key>
	<string>development</string>
	<!-- Sign in with Apple -->
	<key>com.apple.developer.applesignin</key>
	<array>
		<string>Default</string>
	</array>
</dict>
</plist>
